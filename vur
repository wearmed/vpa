#!/usr/bin/env bash
# vur -- Void User Repository: an AUR helper for Void Linux.
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=$(cd "$(dirname "$SELF")" && pwd)
export ROOT

# shellcheck source=lib/common.sh
source "$ROOT/lib/common.sh"
# shellcheck source=lib/aur.sh
source "$ROOT/lib/aur.sh"
# shellcheck source=lib/pkgbuild.sh
source "$ROOT/lib/pkgbuild.sh"
# shellcheck source=lib/deps.sh
source "$ROOT/lib/deps.sh"
# shellcheck source=lib/build.sh
source "$ROOT/lib/build.sh"
# shellcheck source=lib/xbps.sh
source "$ROOT/lib/xbps.sh"

usage() {
  cat <<EOF
vur - AUR helper for Void Linux
XBPS version: $(xbps-query -V 2>/dev/null || echo unknown)

USAGE:
vur [OPTIONS] [SUBCOMMANDS] [<ARGS>]

OPTIONS:
--color=<yes|no|auto>        - Enable/disable colorized output (default: auto)
--noconfirm, -y               - Never prompt for confirmation
--edit                         - Open each PKGBUILD in \$EDITOR before building
--devel                        - Also rebuild -git/-svn/-hg packages on
                                  upgrade if upstream moved past pkgver
--help                         - (same as: help)

SUBCOMMANDS:
search (s) <term>             - Search the AUR
info <pkg>                     - Show information about <package>
install (i) <pkg(s)>           - Build and install <package(s)> from the AUR
                                  (no exact match opens an interactive
                                  numbered picker over the search results)
remove (rm) <pkg(s)>            - Remove <package(s)> (via xbps-remove)
upgrade (up)                   - Offer a full system upgrade, then rebuild
                                  any vur-tracked package with a newer
                                  AUR version
clean (cl)                     - Wipe the build cache and local package repo
list (ls)                      - List packages vur has installed
help                            - Show usage information
helppager (hp)                 - Show usage information (piped to \$PAGER)

CONFIG FILE:
~/.config/vur/vur.conf (NOCONFIRM=1, EDITOR=..., CLEAN_AFTER=1)
EOF
}

# warn_systemd_forcing_flags <pkgbuild-file> -- static grep for build flags
# that unconditionally require systemd (breaks on Void/Artix-style runit).
warn_systemd_forcing_flags() {
  local file=$1 hit
  hit=$(grep -nEo -- '--(with|enable)-systemd|-Dsystemd=(true|enabled)|-D(WITH_)?SYSTEMD(_SUPPORT)?=(ON|1)|USE_SYSTEMD=1' "$file" 2>/dev/null) || return 0
  [[ -n "$hit" ]] || return 0
  warn "this PKGBUILD unconditionally requests systemd support, which doesn't exist on Void (runit):"
  printf '%s\n' "$hit" | sed 's/^/    /' >&2
  warn "the build will likely fail unless you --edit it first and flip these to their disabled form (--without-systemd, --disable-systemd, -Dsystemd=false/disabled, -D(WITH_)SYSTEMD=OFF, etc.)"
}

# review_and_load <pkgbase> <gitdir> -- show diff/PKGBUILD, --edit, confirm, then load
review_and_load() {
  local pkgbase=$1 dir=$2
  local inst snapshot="$REVIEWED_DIR/$pkgbase.PKGBUILD"

  if [[ -f "$snapshot" ]] && cmp -s "$snapshot" "$dir/PKGBUILD"; then
    info "PKGBUILD for $pkgbase is unchanged since last review"
  elif [[ -f "$snapshot" ]]; then
    info "PKGBUILD for $pkgbase changed since last review:"
    diff -u -- "$snapshot" "$dir/PKGBUILD" || true
  else
    info "PKGBUILD for $pkgbase:"
    cat "$dir/PKGBUILD"
  fi

  shopt -s nullglob
  for inst in "$dir"/*.install; do
    info "install scriptlet: $(basename "$inst")"
    cat "$inst"
  done
  shopt -u nullglob

  warn_systemd_forcing_flags "$dir/PKGBUILD"

  if [[ "$EDIT_PKGBUILD" == "1" ]]; then
    confirm "Open PKGBUILD for $pkgbase in $VUR_EDITOR before building?" && "$VUR_EDITOR" "$dir/PKGBUILD"
  fi

  confirm "Build and install '$pkgbase' using the PKGBUILD shown above?" || die "aborted by user for $pkgbase"
  cp -- "$dir/PKGBUILD" "$snapshot"
  pkgbuild_load "$dir"
}

# interactive_select_pkg <term> -- numbered AUR search picker, prints chosen
# Name(s) to stdout. Accepts indices/ranges, e.g. "1 3 5-7".
interactive_select_pkg() {
  local term=$1 json count
  json=$(aur_rpc_search "$term") || return 1
  count=$(jq -r '.resultcount // 0' <<<"$json")
  if [[ "$count" -eq 0 ]]; then
    warn "no AUR results for '$term'"
    return 1
  fi

  local names=() metas=()
  mapfile -t names < <(jq -r '.results | sort_by(.Popularity) | .[].Name' <<<"$json")
  mapfile -t metas < <(jq -r '.results | sort_by(.Popularity) | .[] | (.Version + "\t" + (.Description // ""))' <<<"$json")

  local n=${#names[@]} i v d
  for ((i = n - 1; i >= 0; i--)); do
    IFS=$'\t' read -r v d <<<"${metas[$i]}"
    printf '%s%2d%s aur/%s %s\n' "$c_bold" "$((i + 1))" "$c_reset" "${names[$i]}" "$v" >&2
    [[ -n "$d" ]] && printf '    %s\n' "$d" >&2
  done

  local choice
  read -r -p "packages to install (e.g. '1 3 5-7', enter to cancel): " choice
  [[ -n "$choice" ]] || return 1

  local tok sel=()
  for tok in $choice; do
    if [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
      local lo=${BASH_REMATCH[1]} hi=${BASH_REMATCH[2]} j
      for ((j = lo; j <= hi; j++)); do
        (( j >= 1 && j <= n )) && sel+=("${names[$((j - 1))]}")
      done
    elif [[ "$tok" =~ ^[0-9]+$ ]] && (( tok >= 1 && tok <= n )); then
      sel+=("${names[$((tok - 1))]}")
    fi
  done
  [[ ${#sel[@]} -gt 0 ]] || return 1
  printf '%s\n' "${sel[@]}"
}

cmd_install() {
  local pkgs=("$@")
  [[ ${#pkgs[@]} -gt 0 ]] || die "usage: vur install <pkg> [pkg...]"
  require_bin jq jq
  require_bin curl curl
  require_bin git git
  require_bin fakeroot fakeroot
  require_bin xbps-create xbps

  resolve_deps_init
  local name base bases=() picked pname json
  # One batched multiinfo request for all directly-named packages instead of one per name.
  json=$(aur_rpc_info "${pkgs[@]}") || die "AUR lookup failed"
  for name in "${pkgs[@]}"; do
    base=$(jq -r --arg n "$name" '.results[] | select(.Name == $n) | .PackageBase' <<<"$json")
    if [[ -n "$base" ]]; then
      bases+=("$base")
    else
      picked=()
      mapfile -t picked < <(interactive_select_pkg "$name") || die "'$name' not found in AUR"
      [[ ${#picked[@]} -gt 0 ]] || die "no package selected for '$name'"
      for pname in "${picked[@]}"; do
        base=$(aur_pkgbase "$pname") || die "'$pname' not found in AUR"
        bases+=("$base")
      done
    fi
  done

  local dir
  for base in "${bases[@]}"; do
    dir="$BUILD_DIR/$base/git"
    aur_clone "$base" "$dir"
    resolve_pkgbase "$base" "$dir"
  done

  if [[ ${#PLAN_UNRESOLVED[@]} -gt 0 ]]; then
    warn "unresolved dependencies:"
    printf '  - %s\n' "${PLAN_UNRESOLVED[@]}" >&2
    confirm "Continue anyway?" || die "aborted due to unresolved dependencies"
  fi
  info "build order: ${PLAN_ORDER[*]}"

  local built_pkgnames=() pb
  for pb in "${PLAN_ORDER[@]}"; do
    pkgbuild_load "$BUILD_DIR/$pb/git"
    fetch_sources "$pb"
    run_build "$pb"
    run_package "$pb"
    local deps_str n
    deps_str=$(runtime_deps_string)
    while IFS= read -r n; do
      create_xbps_pkg "$n" "$PB_PKGVER" "$PB_PKGREL" \
        "$BUILD_DIR/$pb/pkg/$n" "$deps_str" "$PB_PKGDESC" "$PB_URL" "${PB_LICENSE[*]:-}"
      built_pkgnames+=("$n")
    done < <(pkgbuild_names)
  done

  index_repo
  install_from_local "${built_pkgnames[@]}"

  for pb in "${PLAN_ORDER[@]}"; do
    pkgbuild_load "$BUILD_DIR/$pb/git"
    local n commit
    commit=$(built_vcs_commit "$pb")
    while IFS= read -r n; do
      manifest_set "$n" "${PB_PKGVER}-${PB_PKGREL}" "$commit"
    done < <(pkgbuild_names)
    if [[ "$CLEAN_AFTER" == "1" ]]; then
      rm -rf "${BUILD_DIR:?}/$pb/src" "${BUILD_DIR:?}/$pb/pkg"
    fi
  done
  ok "installed: ${built_pkgnames[*]}"
}

cmd_remove() {
  local pkgs=("$@")
  [[ ${#pkgs[@]} -gt 0 ]] || die "usage: vur remove <pkg> [pkg...]"
  sudo xbps-remove -y "${pkgs[@]}" || die "xbps-remove failed"
  local p
  for p in "${pkgs[@]}"; do manifest_remove "$p"; done
  ok "removed: ${pkgs[*]}"
}

cmd_upgrade() {
  if confirm "Run a full system upgrade first (sudo xbps-install -Su)?"; then
    sudo xbps-install -Su || warn "system upgrade failed or was declined by xbps; continuing to AUR packages"
  fi

  if [[ ! -s "$MANIFEST" ]]; then
    info "nothing tracked by vur yet"
    return 0
  fi
  require_bin jq jq

  local names=() curvers=() curcommits=() name curver curcommit
  while IFS=$'\t' read -r name curver curcommit; do
    [[ -n "$name" ]] || continue
    names+=("$name") curvers+=("$curver") curcommits+=("$curcommit")
  done < "$MANIFEST"
  if [[ ${#names[@]} -eq 0 ]]; then
    info "nothing tracked by vur yet"
    return 0
  fi

  # One batched multiinfo request for every tracked package instead of one per name.
  local json; json=$(aur_rpc_info "${names[@]}") || die "AUR lookup failed"

  local outdated=() i base dir latest remote
  for i in "${!names[@]}"; do
    name=${names[$i]} curver=${curvers[$i]} curcommit=${curcommits[$i]}
    remote=$(jq -r --arg n "$name" '.results[] | select(.Name == $n) | .Version' <<<"$json")
    if [[ -z "$remote" ]]; then
      warn "'$name' no longer found on AUR"
      continue
    fi
    if [[ "$remote" != "$curver" ]]; then
      info "$name: $curver -> $remote"
      outdated+=("$name")
      continue
    fi
    if [[ "$DEVEL" == "1" && -n "$curcommit" ]]; then
      base=$(jq -r --arg n "$name" '.results[] | select(.Name == $n) | .PackageBase' <<<"$json")
      [[ -n "$base" ]] || continue
      dir="$BUILD_DIR/$base/git"
      aur_clone "$base" "$dir" >/dev/null
      pkgbuild_load "$dir"
      latest=$(pkgbuild_devel_latest_commit)
      if [[ -n "$latest" && "$latest" != "$curcommit" ]]; then
        info "$name: devel commit changed (${curcommit:0:8} -> ${latest:0:8})"
        outdated+=("$name")
      fi
    fi
  done

  if [[ ${#outdated[@]} -eq 0 ]]; then
    ok "everything up to date"
    return 0
  fi
  confirm "Rebuild ${#outdated[@]} package(s): ${outdated[*]}?" || die "aborted"
  cmd_install "${outdated[@]}"
}

cmd_clean() {
  info "removing build cache: $BUILD_DIR"
  rm -rf "${BUILD_DIR:?}"/*
  mkdir -p "$BUILD_DIR"
  if confirm "Also clear the local package repo at $REPO_DIR (rebuilt automatically as needed)?"; then
    rm -f "$REPO_DIR"/*.xbps "$REPO_DIR"/*-repodata "$REPO_DIR"/*-stagedata 2>/dev/null || true
    ok "cleared $REPO_DIR"
  fi
  ok "cleaned"
}

cmd_list() {
  if [[ ! -s "$MANIFEST" ]]; then
    info "nothing tracked by vur"
    return 0
  fi
  awk -F'\t' '{ printf "%-30s %-15s %s\n", $1, $2, ($3 != "" ? "(devel)" : "") }' "$MANIFEST"
}

# Global flags may appear anywhere in argv; strip them out before dispatching.
ARGS=()
for a in "$@"; do
  case "$a" in
    --noconfirm|-y) NOCONFIRM=1 ;;
    --edit) EDIT_PKGBUILD=1 ;;
    --devel) DEVEL=1 ;;
    --color=*) set_colors "${a#*=}" ;;
    --help) usage; exit 0 ;;
    *) ARGS+=("$a") ;;
  esac
done
set -- "${ARGS[@]}"

cmd=${1:-}
[[ $# -gt 0 ]] && shift

case "$cmd" in
  search|s)     cmd_search "$@" ;;
  info)         cmd_info "$@" ;;
  install|i)    cmd_install "$@" ;;
  remove|rm)    cmd_remove "$@" ;;
  upgrade|up)   cmd_upgrade "$@" ;;
  clean|cl)     cmd_clean "$@" ;;
  list|ls)      cmd_list "$@" ;;
  ""|-h|help)   usage ;;
  helppager|hp) usage | "${PAGER:-less}" ;;
  *) die "unknown command '$cmd' (try: vur help)" ;;
esac
